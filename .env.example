# All API calls go through OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model used to write description variants. Free on OpenRouter.
VARIANT_MODEL=stealth/space-bunny-alpha
# Space Bunny reasons by default at max effort. Low keeps short descriptions fast.
VARIANT_REASONING_EFFORT=low
# Model that plays the AI shopping agent and returns rankings.
RANK_MODEL=openai/gpt-4.1-mini

# Raise once you know your OpenRouter rate limit; this caps in-flight requests.
CONCURRENCY=16

HF_HOME=.hf_cache
