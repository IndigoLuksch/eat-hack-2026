# All API calls go through OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model used to write description variants. Fast and cheap; no reasoning step.
VARIANT_MODEL=google/gemini-2.5-flash-lite
VARIANT_REASONING_EFFORT=
# Model that plays the AI shopping agent and returns rankings.
RANK_MODEL=openai/gpt-4.1-mini
# Strong hosted baseline shown beside the fine-tune in the demo.
BASELINE_MODEL=anthropic/claude-opus-4.6
# Untuned Qwen stand-in for the fine-tune base (4B is gone from OpenRouter).
BASE_QWEN_MODEL=qwen/qwen3-8b

# Raise once you know your OpenRouter rate limit; this caps in-flight requests.
CONCURRENCY=16

HF_HOME=.hf_cache

# Demo writer. openrouter on Render; mlx or trl for the custom model locally.
DEMO_BACKEND=openrouter
DEMO_MODEL=google/gemini-2.5-flash-lite
# Local adapter/merged model directory, or Hugging Face repo id. Used by mlx and trl.
DEMO_ADAPTER=lollygag/qwen3-4b-juice-descriptions
# Render needs this when DEMO_ADAPTER is a private Hugging Face repo.
HF_TOKEN=
