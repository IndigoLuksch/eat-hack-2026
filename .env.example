# All API calls go through OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model used to write description variants.
VARIANT_MODEL=anthropic/claude-3.5-sonnet
# Model that plays the AI shopping agent and returns rankings.
RANK_MODEL=openai/gpt-4o-mini

# Raise once you know your OpenRouter rate limit; this caps in-flight requests.
CONCURRENCY=16

HF_HOME=.hf_cache
